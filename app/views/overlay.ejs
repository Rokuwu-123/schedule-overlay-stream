<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Overlay Client</title>
</head>

<body>

    <iframe
        id="overlayFrame"
        style="
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            border: none;
            background: transparent;
        "
    ></iframe>
    <input type="text" id="fileInput" value="<%=uuid%>" style="display: none;" />
    <script src="/src/socket-client.js" type="module"></script>

</body>

</html>